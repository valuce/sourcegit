<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="SourceGit.Views.CleanWorkingCopy"
             x:DataType="vm:CleanWorkingCopy">
  <StackPanel Orientation="Vertical" Margin="8,0,0,0">
    <StackPanel Orientation="Horizontal">
      <Path Width="16" Height="16"
            Data="{StaticResource Icons.Clean}"/>

      <TextBlock FontSize="18"
                 Margin="8,0,0,0"
                 Classes="bold"
                 Text="{DynamicResource Text.CleanWorkingCopy}"/>
    </StackPanel>

    <Grid Margin="0,16,0,8" RowDefinitions="32,32,32,32,Auto,Auto" ColumnDefinitions="120,*">
      <TextBlock Grid.Row="0" Grid.Column="0"
                 Margin="0,0,8,0"
                 HorizontalAlignment="Right"
                 Text="{DynamicResource Text.CleanWorkingCopy.Remove}"/>
      <TextBlock Grid.Row="0" Grid.Column="1"
                 Text="{DynamicResource Text.CleanWorkingCopy.Tip}"/>

      <CheckBox Grid.Row="1" Grid.Column="1"
                Content="{DynamicResource Text.CleanWorkingCopy.Untracked}"
                IsChecked="{Binding IncludeUntracked, Mode=TwoWay}"
                ToolTip.Tip="git clean -d"/>

      <CheckBox Grid.Row="2" Grid.Column="1"
                Content="{DynamicResource Text.CleanWorkingCopy.Ignored}"
                IsChecked="{Binding IncludeIgnored, Mode=TwoWay}"
                ToolTip.Tip="git clean -X / -x"/>

      <CheckBox Grid.Row="3" Grid.Column="1"
                Content="{DynamicResource Text.CleanWorkingCopy.NestedRepositories}"
                IsChecked="{Binding IncludeNestedRepositories, Mode=TwoWay}"
                IsEnabled="{Binding HasAnythingToClean}"
                ToolTip.Tip="git clean -ff"/>

      <CheckBox Grid.Row="4" Grid.Column="1"
                Height="32"
                Content="{DynamicResource Text.Repository.Clean.IncludeSubmodules}"
                IsChecked="{Binding IncludeSubmodules, Mode=TwoWay}"
                IsEnabled="{Binding HasAnythingToClean}"
                IsVisible="{Binding HasSubmodules}"
                ToolTip.Tip="git submodule foreach --recursive git clean ..."/>

      <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
        <Path Grid.Column="0"
              Width="14" Height="14"
              Data="{StaticResource Icons.Error}"
              Fill="DarkOrange"/>
        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                   Text="{DynamicResource Text.Discard.Warning}"
                   TextWrapping="Wrap"
                   Foreground="DarkOrange"/>
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
